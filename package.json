{
  "name": "drawzware",
  "version": "0.1.0",
  "description": "Local-first visual system architecture diagramming studio",
  "author": "Rajesh Kayal",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "build:electron": "tsc -p electron/tsconfig.json",
    "start:electron": "electron .",
    "test:smoke": "electron . --smoke-test --no-sandbox",
    "desktop": "next build && npm run build:electron && electron .",
    "dist:dir": "npm run build && npm run build:electron && electron-builder --dir",
    "dist": "npm run build && npm run build:electron && electron-builder",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build && npm run build:electron && electron-builder --mac",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux",
    "deploy:cloudflare": "next build && wrangler deploy"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.575.0",
    "lz-string": "^1.5.0",
    "next": "16.1.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/js-yaml": "^4.0.9",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.131.1"
  }
}
