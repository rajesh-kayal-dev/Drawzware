{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@drawzware/contracts": ["./packages/contracts/src/index.ts"],
      "@drawzware/domain": ["./packages/domain/src/index.ts"],
      "@drawzware/canvas-core": ["./packages/canvas-core/src/index.ts"],
      "@drawzware/storage": ["./packages/storage/src/index.ts"],
      "@drawzware/ui": ["./packages/ui/src/index.ts"],
      "@drawzware/api": ["./apps/api/src/app.ts"],
      "@drawzware/api/*": ["./apps/api/src/*"]
    }
  }
}

