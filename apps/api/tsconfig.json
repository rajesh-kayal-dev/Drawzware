{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@drawzware/contracts": ["../../packages/contracts/src/index.ts"],
      "@drawzware/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
