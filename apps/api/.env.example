# Drawzware API Environment Configuration (@drawzware/api)

# Server listener port (default: 3000)
PORT=3000

# Environment mode: development | production | test
NODE_ENV=production

# MongoDB connection URI (Required for workspace membership, diagram snapshots, and CRDT persistence)
MONGO_URI=mongodb://127.0.0.1:27017/drawzware

# Cryptographic secret for signing and verifying JWT tokens (Minimum 32 characters required in production)
JWT_SECRET=replace_with_strong_production_jwt_secret_at_least_32_characters_long

# Allowed web client origin(s) for Express CORS and WebSocket upgrade validation (comma-separated for multiple)
WEB_ORIGIN=http://localhost:3000,https://drawzware.com,https://app.drawzware.com

# Public application URL for email link generation (verification, reset, invitations)
APP_URL=http://localhost:3000

# Optional SMTP Email Configuration (If not configured, email service operates in safe mock/console mode)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your-smtp-secret-password
SMTP_FROM=Drawzware <noreply@drawzware.com>
SMTP_SECURE=false

