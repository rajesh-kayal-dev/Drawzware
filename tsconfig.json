{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./apps/web/src/*"],
      "@drawzware/contracts": ["./packages/contracts/src/index.ts"],
      "@drawzware/domain": ["./packages/domain/src/index.ts"],
      "@drawzware/canvas-core": ["./packages/canvas-core/src/index.ts"],
      "@drawzware/storage": ["./packages/storage/src/index.ts"],
      "@drawzware/ui": ["./packages/ui/src/index.ts"],
      "@drawzware/api": ["./apps/api/src/app.ts"],
      "@drawzware/api/*": ["./apps/api/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "dist-electron", "apps/desktop", "apps/api/authentication", "scratch"]
}
