# Drawzware Global Environment Variables Example
# Drawzware's personal canvas experience is 100% offline and client-side by default with zero required backend dependencies.
# Cloud collaboration and workspace synchronization are opt-in and backed by @drawzware/api.

# --- Client Application Configuration (apps/web) ---
# Optional: WebSocket server URL for real-time collaboration (defaults to current host:3000/collab in dev)
# NEXT_PUBLIC_WS_URL=wss://api.drawzware.com/collab

# Optional: Migration target URL if migrating projects from a legacy domain
# NEXT_PUBLIC_MIGRATE_TO=https://drawzware.vercel.app

# --- Desktop Application Configuration (apps/desktop) ---
# Optional: Allowed remote API origin permitted by desktop Content Security Policy (CSP)
# DRAWZWARE_API_ORIGIN=https://api.drawzware.com

# --- Backend API Service Configuration (apps/api) ---
# Server listener port (default: 3000)
PORT=3000

# Environment mode: development | production | test
NODE_ENV=production

# MongoDB connection URI (Required for opt-in cloud workspaces, diagram snapshots, and CRDT synchronization)
MONGO_URI=mongodb://127.0.0.1:27017/drawzware

# Cryptographic secret for signing and verifying JWT tokens (Minimum 32 characters required in production)
JWT_SECRET=replace_with_strong_production_jwt_secret_at_least_32_characters_long

# Allowed web client origin(s) for CORS and WebSocket upgrade origin validation (comma-separated for multiple)
WEB_ORIGIN=http://localhost:3000,https://drawzware.com,https://app.drawzware.com
